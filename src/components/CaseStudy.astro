---
import { CheckCircle2 } from 'lucide-astro';

const values = [
  { label: "Contenido con Criterio", icon: CheckCircle2 },
  { label: "Estrategia antes que Estética", icon: CheckCircle2 },
  { label: "Resultados Medibles", icon: CheckCircle2 },
];
---

<section class="py-24 relative overflow-hidden bg-charcoal-grey">
  <div class="container mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
    
    <div data-aos="fade-right">
      <span class="text-electric-blue font-bold tracking-widest uppercase text-sm block mb-4">Mi Propuesta de Valor</span>
      <h2 class="text-3xl md:text-6xl font-bold mb-8 leading-tight">Por qué trabajar <span class="text-gradient">conmigo</span></h2>
      <p class="text-white/70 text-xl leading-relaxed mb-10">
        No prometo números mágicos. Trabajo con criterio técnico, estrategia comprobada y análisis real de datos. Tu marca merece algo más que promesas vacías: merece honestidad y resultados medibles.
      </p>

      <div class="space-y-4">
        {values.map((item, index) => (
          <div
            class="flex items-center gap-4 p-4 rounded-xl bg-black-deep/40 border border-white/5 backdrop-blur-md group hover:border-electric-blue/20 transition-all"
            data-aos="fade-up"
            data-aos-delay={index * 100}
          >
            <item.icon class="w-6 h-6 text-electric-blue flex-shrink-0" />
            <span class="text-lg font-semibold text-white group-hover:text-electric-blue transition-colors">{item.label}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="relative" data-aos="fade-left">
      <!-- Pillars Visualization -->
      <div class="relative z-10 p-8 rounded-[40px] bg-gradient-to-br from-white/10 to-white/5 border border-white/10 backdrop-blur-xl shadow-2xl">
        <h3 class="text-2xl font-bold mb-8 text-center">Mi Metodología</h3>

        <div class="grid grid-cols-1 gap-6">
          {values.map((item, index) => (
            <div
              class="flex items-start gap-4 p-4 rounded-2xl bg-black-deep/40 border border-white/5 hover:border-electric-blue/20 transition-all"
              data-aos="fade-up"
              data-aos-delay={index * 150}
            >
              <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-electric-blue/10 border border-electric-blue/30 flex-shrink-0">
                <item.icon class="w-6 h-6 text-electric-blue" />
              </div>
              <div>
                <p class="font-semibold text-white mb-1">{item.label}</p>
                <p class="text-sm text-white/50">
                  {index === 0 && "Cada estrategia se desarrolla con criterio técnico, no intuición."}
                  {index === 1 && "La estética sigue a la estrategia, no al revés."}
                  {index === 2 && "Cada acción se mide, se analiza y se optimiza."}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Decorative elements -->
      <div class="absolute -top-10 -right-10 w-40 h-40 bg-electric-blue/20 blur-[60px] rounded-full"></div>
      <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-neon-violet/20 blur-[60px] rounded-full"></div>
    </div>
  </div>
</section>
