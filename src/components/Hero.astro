---
import { ArrowRight, Check } from 'lucide-astro';
import { waLink } from '../data/site.js';

const points = ['Presupuesto sin cargo', 'Sitios rápidos y pensados para celular', 'Contacto directo por WhatsApp'];
---

<section class="relative min-h-[92vh] flex items-center overflow-hidden pt-28 pb-16">
  <div class="absolute inset-0 z-0 pointer-events-none">
    <div class="absolute top-1/4 -left-20 w-64 h-64 md:w-96 md:h-96 bg-electric-blue/10 blur-[80px] md:blur-[120px] rounded-full"></div>
    <div class="absolute bottom-1/4 -right-20 w-64 h-64 md:w-96 md:h-96 bg-neon-violet/10 blur-[80px] md:blur-[120px] rounded-full"></div>
  </div>

  <div class="container mx-auto px-6 relative z-10 grid lg:grid-cols-[1.1fr_1fr] gap-14 items-center">
    <div data-aos="fade-up">
      <span class="inline-block px-4 py-1.5 mb-6 text-xs md:text-sm font-semibold tracking-wider uppercase border border-white/20 rounded-full bg-charcoal-grey/30 backdrop-blur-md">
        Webs · Apps · Google Ads · IA
      </span>

      <h1 class="font-bold mb-6 leading-[1.05]">
        Webs y apps que traen <span class="text-gradient">clientes a tu WhatsApp</span>
      </h1>

      <p class="text-lg md:text-xl text-white/70 mb-8 max-w-xl leading-relaxed">
        Soy Gastón. Diseño y programo páginas web para negocios de zona sur y GBA, y las conecto con Google Ads y automatizaciones para que las consultas te lleguen solas.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 mb-10">
        <a href={waLink()} target="_blank" rel="noopener" data-astro-reload class="group px-8 py-4 bg-electric-blue text-black font-bold rounded-xl transition-all hover:glow-blue hover:scale-105 active:scale-95 flex items-center justify-center gap-2">
          Pedí tu presupuesto
          <ArrowRight class="w-5 h-5 group-hover:translate-x-1 transition-transform" />
        </a>
        <a href="#trabajos" class="px-8 py-4 bg-white/5 backdrop-blur-md border border-white/10 text-white font-bold rounded-xl transition-all hover:bg-white/10 text-center">
          Ver trabajos
        </a>
      </div>

      <ul class="flex flex-col sm:flex-row sm:flex-wrap gap-x-6 gap-y-2 text-white/60 text-sm">
        {points.map((p) => (
          <li class="flex items-center gap-2"><Check class="w-4 h-4 text-electric-blue" />{p}</li>
        ))}
      </ul>
    </div>

    <!-- Collage de trabajos reales -->
    <div class="relative hidden md:block h-[440px]" data-aos="fade-left" aria-hidden="true">
      <img src="/trabajos/plomeria.webp" alt="" class="absolute top-0 right-0 w-[78%] rounded-2xl border border-white/10 shadow-2xl" loading="eager" />
      <img src="/trabajos/ferclean.webp" alt="" class="absolute top-[34%] left-0 w-[62%] rounded-2xl border border-white/10 shadow-2xl" loading="eager" />
      <img src="/trabajos/alma.webp" alt="" class="absolute bottom-0 right-[6%] w-[52%] rounded-2xl border border-white/10 shadow-2xl glow-blue" loading="eager" />
    </div>
  </div>
</section>

<style>
  h1 {
    font-size: clamp(2.4rem, 6vw, 4.6rem);
  }
</style>
