---
---

<div id="intro" class="fixed inset-0 z-[200] bg-black-deep flex items-center justify-center overflow-hidden">
  <!-- Background effects -->
  <div class="absolute inset-0 z-0 pointer-events-none">
    <div class="absolute top-1/4 -left-20 w-64 h-64 md:w-96 md:h-96 bg-electric-blue/10 blur-[80px] md:blur-[120px] rounded-full"></div>
    <div class="absolute bottom-1/4 -right-20 w-64 h-64 md:w-96 md:h-96 bg-neon-violet/10 blur-[80px] md:blur-[120px] rounded-full"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 flex flex-col items-center justify-center text-center px-6 space-y-8">
    <!-- Logo with animation -->
    <img
      src="/brand-logo.png"
      alt="Gasty Creative"
      class="h-24 w-auto animate-fade-in-scale"
    />

    <!-- Phrase -->
    <div class="space-y-4 animate-fade-in-delay">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold leading-tight max-w-2xl">
        Contenido que <span class="text-gradient">genera resultados</span>
      </h2>
      <p class="text-lg md:text-xl text-white/70 max-w-xl">
        Estrategia, creatividad y tecnología para que tu marca crezca
      </p>
    </div>

    <!-- Skip text -->
    <p class="text-sm text-white/40 mt-12 animate-bounce opacity-70">
      Haz click para continuar
    </p>
  </div>
</div>

<style>
  @keyframes fadeInScale {
    from {
      opacity: 0;
      transform: scale(0.8);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes fadeInDelay {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-scale {
    animation: fadeInScale 0.8s ease-out forwards;
  }

  .animate-fade-in-delay {
    animation: fadeInDelay 0.8s ease-out 0.3s forwards;
    opacity: 0;
  }

  #intro.fade-out {
    animation: fadeOut 0.8s ease-out forwards;
  }

  @keyframes fadeOut {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
      pointer-events: none;
    }
  }
</style>

<script>
  function closeIntro() {
    const intro = document.getElementById('intro');
    if (intro) {
      intro.classList.add('fade-out');
      setTimeout(() => {
        intro.style.display = 'none';
      }, 800);
    }
  }

  // Cerrar al hacer click
  document.getElementById('intro')?.addEventListener('click', closeIntro);

  // Cerrar automáticamente después de 3 segundos
  setTimeout(closeIntro, 3000);
</script>
