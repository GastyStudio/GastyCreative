---
const steps = [
  { n: '01', title: 'Charlamos', text: 'Me contás por WhatsApp qué hace tu negocio y qué querés lograr. Sin compromiso.' },
  { n: '02', title: 'Propuesta', text: 'Te paso qué incluye, cuánto cuesta y en qué plazo. Precio cerrado, sin sorpresas.' },
  { n: '03', title: 'Diseño y desarrollo', text: 'Vas viendo avances en un link y pedís cambios antes de publicar.' },
  { n: '04', title: 'Publicación y soporte', text: 'Subo la web con tu dominio, te enseño a usarla y sigo disponible para ajustes.' },
];
---

<section id="proceso" class="py-24 bg-charcoal-grey relative overflow-hidden">
  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-2xl mb-14" data-aos="fade-up">
      <span class="text-electric-blue font-bold tracking-widest uppercase text-sm block mb-4">Cómo trabajo</span>
      <h2 class="text-3xl md:text-5xl font-bold">De la idea a la web <span class="text-gradient">en 4 pasos</span></h2>
    </div>

    <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {steps.map((s, i) => (
        <li class="p-7 rounded-3xl bg-black-deep/50 border border-white/5" data-aos="fade-up" data-aos-delay={i * 100}>
          <span class="text-4xl font-bold text-gradient block mb-4">{s.n}</span>
          <h3 class="text-xl font-bold mb-2">{s.title}</h3>
          <p class="text-white/60 leading-relaxed">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
  <div class="absolute -top-10 -right-10 w-60 h-60 bg-electric-blue/10 blur-[80px] rounded-full"></div>
  <div class="absolute -bottom-10 -left-10 w-60 h-60 bg-neon-violet/10 blur-[80px] rounded-full"></div>
</section>
