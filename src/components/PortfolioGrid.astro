---
import { ArrowUpRight } from 'lucide-astro';

// Trabajos publicados. Para sumar uno: captura 1280x800 en /public/trabajos y un objeto acá.
const projects = [
  {
    client: 'Fernando Plomería',
    sector: 'Plomería · CABA y GBA',
    type: 'Sitio web',
    image: '/trabajos/plomeria.webp',
    description: 'Sitio para un plomero matriculado: servicios, zonas de cobertura y un botón de urgencias que abre WhatsApp con un toque.',
    url: 'https://plomeria24hs.com.ar',
    domain: 'plomeria24hs.com.ar',
  },
  {
    client: 'Fernando Piscinas',
    sector: 'Piscinas · Zona sur',
    type: 'Landing page',
    image: '/trabajos/alma.webp',
    description: 'Landing de mantenimiento y reparación de piletas, armada para recibir pedidos de presupuesto por WhatsApp y campañas de Google Ads.',
    url: 'https://www.fernandopiscinas.com.ar',
    domain: 'fernandopiscinas.com.ar',
  },
  {
    client: 'FER CLEAN',
    sector: 'Limpieza exterior',
    type: 'Landing page',
    image: '/trabajos/ferclean.webp',
    description: 'Limpieza de tejados, fachadas y veredas con hidrolavadora. Página enfocada en mostrar resultados y llevar a la consulta.',
    url: 'https://ferclean.com.ar',
    domain: 'ferclean.com.ar',
  },
  {
    client: 'NOVA Iglesia',
    sector: 'Comunidad · Banfield',
    type: 'Sitio web',
    image: '/trabajos/nova.webp',
    description: 'Sitio de varias secciones en Next.js, con un recorrido para quien visita por primera vez y captación de datos desde Instagram.',
    url: 'https://nova-iglesia.vercel.app',
    domain: 'nova-iglesia.vercel.app',
  },
  {
    client: 'Cerámicas P.A.H.M.A.',
    sector: 'Revestimientos',
    type: 'App web',
    image: '/trabajos/pahama.webp',
    description: 'Catálogo online de cerámicas y porcelanatos, hecho en React, con pedido de presupuesto directo.',
    url: 'https://ceramicas-web-pahma.vercel.app',
    domain: 'ceramicas-web-pahma.vercel.app',
  },
  {
    client: 'Barbero Express',
    sector: 'Barbería a domicilio',
    type: 'Landing page',
    image: '/trabajos/barbero.webp',
    description: 'Landing para un barbero que trabaja a domicilio en zona sur: servicios, cursos y reserva de turnos.',
    url: 'https://barbero-express.vercel.app',
    domain: 'barbero-express.vercel.app',
  },
];

const apps = [
  { name: 'Fútbol Fácil', description: 'App para organizar partidos con amigos en segundos.', url: 'https://futbol-facil.vercel.app' },
  { name: 'Bio Hacker', description: 'App para medir y seguir el rendimiento físico.', url: 'https://bio-hacker-app.vercel.app' },
];
---

<section id="trabajos" class="py-24 bg-charcoal-grey/20">
  <div class="container mx-auto px-6">
    <div class="mb-14 max-w-2xl" data-aos="fade-up">
      <span class="text-electric-blue font-bold tracking-widest uppercase text-sm block mb-4">Trabajos</span>
      <h2 class="text-3xl md:text-5xl font-bold mb-4">Negocios reales, <span class="text-gradient">webs funcionando</span></h2>
      <p class="text-white/60 text-lg">
        Todos están publicados y en uso. Entrá y probalos desde tu celular.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projects.map((p, i) => (
        <a
          href={p.url}
          target="_blank"
          rel="noopener"
          class="group flex flex-col overflow-hidden rounded-3xl bg-charcoal-grey border border-white/5 hover:border-electric-blue/40 transition-all duration-300 hover:-translate-y-1.5"
          data-aos="fade-up"
          data-aos-delay={(i % 3) * 100}
        >
          <div class="aspect-[16/10] overflow-hidden relative bg-black">
            <img src={p.image} alt={`Página web de ${p.client}`} loading="lazy" width="1280" height="800" class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105" />
            <span class="absolute top-4 left-4 px-3 py-1 rounded-full bg-black/70 backdrop-blur-md border border-white/20 text-xs font-bold uppercase tracking-wider">
              {p.type}
            </span>
          </div>
          <div class="p-7 flex flex-col flex-1">
            <p class="text-electric-blue/80 text-sm font-semibold mb-1">{p.sector}</p>
            <h3 class="text-2xl font-bold mb-3">{p.client}</h3>
            <p class="text-white/60 mb-6 flex-1">{p.description}</p>
            <span class="flex items-center justify-between text-sm font-semibold text-white/50 group-hover:text-electric-blue transition-colors">
              {p.domain}
              <ArrowUpRight class="w-5 h-5 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 transition-transform" />
            </span>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-14 p-8 rounded-3xl border border-white/10 bg-black-deep/40" data-aos="fade-up">
      <h3 class="text-xl font-bold mb-2">También desarrollo apps</h3>
      <p class="text-white/60 mb-6">Proyectos propios donde pruebo herramientas que después aplico en clientes.</p>
      <div class="grid sm:grid-cols-2 gap-4">
        {apps.map((a) => (
          <a href={a.url} target="_blank" rel="noopener" class="group flex items-center justify-between gap-4 p-5 rounded-2xl bg-charcoal-grey/60 border border-white/5 hover:border-neon-violet/40 transition-colors">
            <div>
              <p class="font-bold">{a.name}</p>
              <p class="text-white/50 text-sm">{a.description}</p>
            </div>
            <ArrowUpRight class="w-5 h-5 shrink-0 text-white/40 group-hover:text-neon-violet transition-colors" />
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
