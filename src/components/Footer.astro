---
import { Github, ArrowUp } from 'lucide-astro';
import { waLink, GITHUB } from '../data/site.js';
---

<footer class="bg-black-deep pt-20 pb-10 border-t border-white/5 relative overflow-hidden">
  <div class="container mx-auto px-6 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-[2fr_1fr_1fr] gap-12 mb-14">
      <div>
        <a href="/" class="flex items-center gap-3 mb-6">
          <img src="/g-mark.png" alt="" class="h-12 w-12 rounded-lg" />
          <span class="font-bold tracking-[0.18em] uppercase">Gasty <span class="text-gradient">Creative</span></span>
        </a>
        <p class="text-white/50 text-lg leading-relaxed max-w-md">
          Páginas web, apps a medida, Google Ads y automatizaciones para negocios de zona sur y GBA.
        </p>
      </div>

      <div>
        <h4 class="text-white font-bold mb-5 uppercase tracking-widest text-sm">Secciones</h4>
        <ul class="space-y-3 text-white/50">
          <li><a href="#trabajos" class="hover:text-electric-blue transition-colors">Trabajos</a></li>
          <li><a href="#servicios" class="hover:text-electric-blue transition-colors">Servicios</a></li>
          <li><a href="#proceso" class="hover:text-electric-blue transition-colors">Cómo trabajo</a></li>
          <li><a href="#sobre-mi" class="hover:text-electric-blue transition-colors">Sobre mí</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-white font-bold mb-5 uppercase tracking-widest text-sm">Contacto</h4>
        <ul class="space-y-3 text-white/50">
          <li><a href={waLink()} target="_blank" rel="noopener" data-astro-reload class="hover:text-electric-blue transition-colors">WhatsApp</a></li>
          <li><a href={GITHUB} target="_blank" rel="noopener" class="hover:text-electric-blue transition-colors inline-flex items-center gap-2"><Github class="w-4 h-4" /> GitHub</a></li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-white/5 flex flex-col md:flex-row items-center justify-between gap-4 text-white/30 text-sm">
      <p>&copy; {new Date().getFullYear()} Gasty Creative · Gastón Coria</p>
      <p>Zona sur, Buenos Aires</p>
    </div>
  </div>

  <div class="absolute -bottom-20 -right-20 w-64 h-64 md:w-80 md:h-80 bg-electric-blue/5 blur-[80px] md:blur-[100px] rounded-full"></div>
  <div class="absolute -bottom-20 -left-20 w-64 h-64 md:w-80 md:h-80 bg-neon-violet/5 blur-[80px] md:blur-[100px] rounded-full"></div>

  <a
    href={waLink()}
    target="_blank"
    rel="noopener"
    data-astro-reload
    aria-label="Escribime por WhatsApp"
    class="fixed bottom-6 right-6 z-[120] flex items-center gap-2 pl-3 pr-4 py-3 bg-[#25D366] text-black font-bold text-sm rounded-full shadow-2xl hover:scale-105 active:scale-95 transition-transform"
  >
    <img src="/whatsapp-favicon.png" alt="" class="w-6 h-6" />
    <span class="hidden sm:inline">Escribime</span>
  </a>

  <button
    onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
    aria-label="Volver arriba"
    class="fixed bottom-6 left-6 z-[80] p-3.5 bg-charcoal-grey/60 border border-white/10 text-white rounded-xl shadow-xl hover:bg-electric-blue hover:text-black transition-colors hidden md:block"
  >
    <ArrowUp class="w-5 h-5" />
  </button>
</footer>
