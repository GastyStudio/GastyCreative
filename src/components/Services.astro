---
import { LayoutTemplate, Globe, Smartphone, TrendingUp, Bot, Check } from 'lucide-astro';
import { waLink } from '../data/site.js';

const services = [
  {
    title: 'Landing page',
    description: 'Una sola página enfocada en que te escriban. Ideal para arrancar o para campañas de Google Ads.',
    points: ['Botón directo a WhatsApp', 'Rápida y pensada para celular', 'Lista para medir consultas'],
    icon: LayoutTemplate,
  },
  {
    title: 'Sitio web completo',
    description: 'Varias secciones para mostrar todo lo que hacés y generar confianza antes del primer contacto.',
    points: ['Servicios, trabajos y zonas', 'Preparado para aparecer en Google', 'Dominio .com.ar y hosting configurados'],
    icon: Globe,
  },
  {
    title: 'App web a medida',
    description: 'Cuando una planilla o un cuaderno ya no alcanzan: una herramienta hecha para tu forma de trabajar.',
    points: ['Turnos, reservas, catálogos o gestión de clientes', 'Funciona en celular y en la compu', 'Panel para administrar vos mismo'],
    icon: Smartphone,
  },
  {
    title: 'Campañas de Google Ads',
    description: 'Aparecé cuando alguien de tu zona busca lo que ofrecés, con la página preparada para convertir esa visita.',
    points: ['Segmentación por zona y servicio', 'Medición de clics a WhatsApp y llamadas', 'Informes claros, sin vueltas'],
    icon: TrendingUp,
  },
  {
    title: 'Automatización con IA',
    description: 'Menos tiempo contestando lo mismo. Respuestas, turnos y seguimiento que funcionan aunque estés trabajando.',
    points: ['Respuestas automáticas a preguntas frecuentes', 'Toma de turnos y datos del cliente', 'Conectado a tu web y WhatsApp'],
    icon: Bot,
  },
];
---

<section id="servicios" class="py-24 bg-black-deep">
  <div class="container mx-auto px-6">
    <div class="text-center mb-16 max-w-2xl mx-auto" data-aos="fade-up">
      <span class="text-electric-blue font-bold tracking-widest uppercase text-sm block mb-4">Servicios</span>
      <h2 class="text-3xl md:text-5xl font-bold mb-4">Lo que puedo <span class="text-gradient">hacer por tu negocio</span></h2>
      <p class="text-white/60 text-lg">
        Podés arrancar con una landing y sumar el resto cuando lo necesites.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((s, i) => (
        <div
          class="p-8 group rounded-3xl bg-charcoal-grey/30 border border-white/5 backdrop-blur-md transition-all duration-300 hover:border-electric-blue/40 flex flex-col"
          data-aos="fade-up"
          data-aos-delay={(i % 3) * 100}
        >
          <div class="mb-6 p-4 rounded-2xl bg-electric-blue/10 w-fit">
            <s.icon class="w-7 h-7 text-electric-blue" />
          </div>
          <h3 class="text-2xl font-bold mb-3">{s.title}</h3>
          <p class="text-white/60 leading-relaxed mb-6">{s.description}</p>
          <ul class="space-y-2 mt-auto">
            {s.points.map((pt) => (
              <li class="flex items-start gap-2 text-white/80 text-sm"><Check class="w-4 h-4 mt-0.5 text-electric-blue shrink-0" />{pt}</li>
            ))}
          </ul>
        </div>
      ))}

      <a
        href={waLink('Hola Gastón, no sé bien qué necesito para mi negocio, ¿me asesorás?')}
        target="_blank"
        rel="noopener"
        data-astro-reload
        class="p-8 rounded-3xl border border-dashed border-electric-blue/40 bg-gradient-to-br from-electric-blue/10 to-neon-violet/10 flex flex-col justify-center hover:scale-[1.02] transition-transform"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        <h3 class="text-2xl font-bold mb-3">¿No sabés qué necesitás?</h3>
        <p class="text-white/70 leading-relaxed mb-6">Contame qué hace tu negocio y te digo qué te conviene, aunque la respuesta sea “todavía nada”.</p>
        <span class="font-bold text-electric-blue">Escribime por WhatsApp →</span>
      </a>
    </div>
  </div>
</section>
